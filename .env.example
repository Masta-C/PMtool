# Copy this to .env.local and fill in your values.
# Get Firebase client config from: Firebase console → Project settings → Your apps → Web app

# Firebase Client Config (safe to expose — these are public keys)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Emulator flags — set to true for local dev, false for production
NEXT_PUBLIC_USE_EMULATOR=true
NEXT_PUBLIC_EMULATOR_HOST=localhost

# Server-side emulator vars (Firebase Admin SDK in API routes)
# These are automatically picked up by the Firebase Admin SDK
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8080
