rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function isAdmin() { return isAuth() && role() in ['admin', 'supervisor']; }
    function isOperatorOrQA() { return isAuth() && role() in ['operator', 'qa']; }
    function isOperatorOrAbove() { return isAuth() && role() in ['admin', 'supervisor', 'operator']; }
    function isQA() { return isAuth() && role() == 'qa'; }
    match /users/{uid} {
      allow read: if isAdmin() || request.auth.uid == uid;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /workstations/{wsId} {
      // Any authenticated user can read workstation status (not sensitive)
      allow read: if isAuth();
      allow write: if isAdmin();
      // Operators can update only machineStatus — field restriction limits blast radius
      // userDoc() get() removed: workstation status is not sensitive enough to warrant
      // a billable cross-document read on every operator status change
      allow update: if isOperatorOrAbove()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['machineStatus']);
      allow delete: if isAdmin();
    }
    match /workOrders/{orderId} {
      // workOrders not yet wired to operator UI; operators/QA get read access by role
      // userDoc() get() removed to avoid billable cross-document reads per operation
      allow read: if isAdmin() || isOperatorOrQA();
      allow create: if isAdmin();
      allow update: if isAdmin() || isOperatorOrQA();
      allow delete: if isAdmin();
    }
    match /products/{productId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }
    match /auditLog/{logId} {
      allow read: if isAdmin();
      allow create: if isAuth();
      allow update, delete: if false;
    }
    match /meters/{meterId} {
      allow read: if isAuth();
      allow create, update: if isOperatorOrAbove();
      allow delete: if false;

      match /stageHistory/{entryId} {
        // QA can only read; operators and above can write; nobody can delete
        allow read: if isAuth();
        allow create, update: if isOperatorOrAbove() && !isQA();
        allow delete: if false;
      }
    }

    // Wildcard rule required for collectionGroup('stageHistory') queries.
    // The nested rule above handles direct doc reads; this covers cross-collection queries
    // used by dashboard metrics and reports (collectionGroup scans all stageHistory subcollections).
    match /{path=**}/stageHistory/{entryId} {
      allow read: if isAuth();
      allow create, update: if isOperatorOrAbove() && !isQA();
      allow delete: if false;
    }
  }
}
