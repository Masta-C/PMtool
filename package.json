{
  "name": "pmtool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "emulators": "firebase emulators:start --import=./emulator-data --export-on-exit",
    "emulators:clean": "firebase emulators:start",
    "dev:full": "concurrently \"npm run dev\" \"npm run emulators\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "seed": "NEXT_PUBLIC_USE_EMULATOR=true FIRESTORE_EMULATOR_HOST=localhost:8080 ts-node --esm scripts/seed.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.9.0",
    "firebase-functions": "^7.2.5",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^9.2.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
